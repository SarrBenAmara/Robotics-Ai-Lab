rules_version = '2';
// Virtual Robotics & AI Lab : Firestore security rules
// Paste this in Firebase console > Firestore Database > Rules, then Publish.
// The teacher usernames here must match window.VLAB_TEACHERS in js/firebase-config.js
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isTeacher() {
      return signedIn() && request.auth.token.email in ['sarra@students.vlab'];
    }
    // each student reads and writes ONLY their own progress; the teacher reads everyone's
    match /progress/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isTeacher());
      allow write: if signedIn() && request.auth.uid == uid;
    }
    // class challenge and settings: everyone logged in reads, only the teacher writes
    match /class/{doc} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }
  }
}
